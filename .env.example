FASTP2P_USER=replace-with-admin-name
FASTP2P_PASSWORD=replace-with-a-long-random-password
# 登录现有管理员账号的邮箱别名
# FASTP2P_ADMIN_EMAIL=a16673997618@gmail.com
# Use exactly 16 decimal digits with a nonzero first digit; keep it private.
FASTP2P_TOKEN=replace-with-16-digit-token
FASTP2P_TLS_CERT=/etc/fastp2p/tls/server.crt
FASTP2P_TLS_KEY=/etc/fastp2p/tls/server.key
FASTP2P_DATABASE=/var/lib/fastp2p/nodes.sqlite3
FASTP2P_PUBLIC_HOST=gateway.example.com
FASTP2P_CA_FILE=/etc/fastp2p/tls/ca.crt
# Optional TLS name and certificate for the primary client WSS listener.
# FASTP2P_CLIENT_TLS_HOST=client.example.com
# FASTP2P_CLIENT_TLS_CERT=/etc/fastp2p/tls/client.crt
# FASTP2P_CLIENT_TLS_KEY=/etc/fastp2p/tls/client.key
# Optional. The repository must publish fastp2p-client-vX.Y.Z releases.
# FASTP2P_RELEASE_REPOSITORY=windows0041/fastp2p
# Optional release metadata and asset acceleration.
# FASTP2P_RELEASE_DOWNLOAD_PREFIX=https://gh-proxy.org/
